<Project>

  <!--
    Generates TypeScript contracts for the RPC services of this project's assembly after each build.
    Set ActualLabRpcTypeScriptOutput to enable it. Other settings:
    - ActualLabRpcTypeScriptServices: comma-separated service type name patterns,
      '*' matches any sequence of characters
    - ActualLabRpcTypeScriptCheck: 'true' fails the build if the file is out of date
      instead of updating it (default on CI)
    - ActualLabRpcTypeScriptTargetFramework: the target framework to generate from,
      if there are many (default: the first one)
  -->
  <PropertyGroup>
    <ActualLabRpcTypeScriptServices Condition="'$(ActualLabRpcTypeScriptServices)' == ''">*</ActualLabRpcTypeScriptServices>
    <ActualLabRpcTypeScriptCheck Condition="'$(ActualLabRpcTypeScriptCheck)' == '' and '$(CI)' == 'true'">true</ActualLabRpcTypeScriptCheck>
    <ActualLabRpcTypeScriptTargetFramework Condition="'$(ActualLabRpcTypeScriptTargetFramework)' == '' and '$(TargetFrameworks)' != ''">$(TargetFrameworks.Split(';')[0].Trim())</ActualLabRpcTypeScriptTargetFramework>
  </PropertyGroup>

  <Target Name="GenerateActualLabRpcTypeScript" AfterTargets="Build"
          Condition="'$(ActualLabRpcTypeScriptOutput)' != '' and '$(DesignTimeBuild)' != 'true' and ('$(ActualLabRpcTypeScriptTargetFramework)' == '' or '$(ActualLabRpcTypeScriptTargetFramework)' == '$(TargetFramework)')">
    <PropertyGroup>
      <!-- The generator must run on a runtime that can load the contracts, so net11.0+ ones need its net11.0 build -->
      <_ActualLabRpcTypeScriptGeneratorFramework>net10.0</_ActualLabRpcTypeScriptGeneratorFramework>
      <_ActualLabRpcTypeScriptGeneratorFramework Condition="'$(TargetFrameworkIdentifier)' == '.NETCoreApp' and $([MSBuild]::VersionGreaterThanOrEquals('$(TargetFrameworkVersion.TrimStart(`v`))', '11.0'))">net11.0</_ActualLabRpcTypeScriptGeneratorFramework>
      <_ActualLabRpcTypeScriptGeneratorPath>$(ActualLabRpcTypeScriptGeneratorPath)</_ActualLabRpcTypeScriptGeneratorPath>
      <_ActualLabRpcTypeScriptGeneratorPath Condition="'$(_ActualLabRpcTypeScriptGeneratorPath)' == ''">$(MSBuildThisFileDirectory)..\tools\$(_ActualLabRpcTypeScriptGeneratorFramework)\ActualLab.Rpc.TypeScript.Generator.dll</_ActualLabRpcTypeScriptGeneratorPath>
      <_ActualLabRpcTypeScriptDotNetHost>$(DOTNET_HOST_PATH)</_ActualLabRpcTypeScriptDotNetHost>
      <_ActualLabRpcTypeScriptDotNetHost Condition="'$(_ActualLabRpcTypeScriptDotNetHost)' == ''">dotnet</_ActualLabRpcTypeScriptDotNetHost>
      <_ActualLabRpcTypeScriptOutputPath>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(ActualLabRpcTypeScriptOutput)'))</_ActualLabRpcTypeScriptOutputPath>
      <_ActualLabRpcTypeScriptCheckArgument Condition="'$(ActualLabRpcTypeScriptCheck)' == 'true'"> --check</_ActualLabRpcTypeScriptCheckArgument>
    </PropertyGroup>
    <Exec Command="&quot;$(_ActualLabRpcTypeScriptDotNetHost)&quot; exec &quot;$(_ActualLabRpcTypeScriptGeneratorPath)&quot; &quot;$(TargetPath)&quot; --output &quot;$(_ActualLabRpcTypeScriptOutputPath)&quot; --services &quot;$(ActualLabRpcTypeScriptServices)&quot;$(_ActualLabRpcTypeScriptCheckArgument)" />
  </Target>

</Project>
