<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks Condition="$(UseMultitargeting)">$(LatestTargetFrameworks)net10.0;net9.0;net8.0;net7.0;net6.0;net5.0;netcoreapp3.1</TargetFrameworks>
    <PackageTags>actual_chat actual_lab actual_lab_fusion rpc server</PackageTags>
    <Description>Server-side components of ActualLab.Rpc</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ActualLab.Rpc\ActualLab.Rpc.csproj" />
  </ItemGroup>

  <!-- HTTP/2 RPC server depends on RpcHttpClientOptions (net5+) -->
  <ItemGroup Condition="$(TargetFramework.StartsWith('netcoreapp'))">
    <Compile Remove="RpcHttpServer*.cs" />
  </ItemGroup>

</Project>
