<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>actuallab-tsgen</ToolCommandName>
    <RollForward>Major</RollForward>
    <IsTrimmable>false</IsTrimmable>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <PackageTags>actual_chat actual_lab actual_lab_fusion rpc typescript</PackageTags>
    <Description>actuallab-tsgen - a .NET tool generating TypeScript contracts for ActualLab.Rpc and Fusion services from a compiled contracts assembly.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ActualLab.Fusion\ActualLab.Fusion.csproj" />
    <ProjectReference Include="..\ActualLab.Rpc.TypeScript\ActualLab.Rpc.TypeScript.csproj" />
  </ItemGroup>

</Project>
