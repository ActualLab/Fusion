<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Samples.TodoApp.Abstractions</RootNamespace>
    <AssemblyName>Samples.TodoApp.Abstractions</AssemblyName>
  </PropertyGroup>

  <!-- Fusion packages -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\ActualLab.Fusion\ActualLab.Fusion.csproj" />
    <ProjectReference Include="..\..\..\src\ActualLab.Fusion.Ext.Contracts\ActualLab.Fusion.Ext.Contracts.csproj" />
  </ItemGroup>

  <!-- Other packages -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
  </ItemGroup>

  <!-- TypeScript contracts for TypeScriptUI, regenerated on build (only checked on CI) -->
  <PropertyGroup>
    <ActualLabRpcTypeScriptOutput>..\TypeScriptUI\src\contracts.generated.ts</ActualLabRpcTypeScriptOutput>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ActualLab.Rpc.TypeScript.Generator" PrivateAssets="all" />
  </ItemGroup>

  <!-- Source generators -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\ActualLab.Generators\ActualLab.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <PackageReference Include="MemoryPack.Generator" PrivateAssets="all" />
  </ItemGroup>

</Project>
